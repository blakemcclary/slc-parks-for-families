# Copy to .env.local for local dev (vercel dev), or set these in the Vercel
# dashboard / `vercel env add` for preview + production. Never commit real values.

# Resend API key (starts with "re_"). https://resend.com/api-keys
RESEND_API_KEY=

# ID of the Resend Audience that holds the confirmed waitlist.
# Create one at https://resend.com/audiences and paste its ID here.
RESEND_AUDIENCE_ID=

# Random high-entropy string used to sign confirmation tokens.
# Generate with: openssl rand -base64 32
SIGNING_SECRET=

# Sender on the verified raisedinslc.org domain (required).
RESEND_FROM=Raised in SLC <hello@raisedinslc.org>

# Public address of this Vercel deployment, used in confirm/unsubscribe links.
# Must match SIGNUP_API in index.html, e.g. https://slc-parks-for-families.vercel.app
API_BASE_URL=

# Static site that confirmed.html lives on. Defaults to https://raisedinslc.org
SITE_URL=

# Extra comma-separated browser origins allowed to call the API (optional),
# e.g. http://localhost:3000 for local testing.
ALLOWED_ORIGINS=

# Google Apps Script web-app URL that appends [email, zip] rows to the sheet.
# Leave blank to skip sheet logging (Resend Audience still works).
GOOGLE_SHEET_WEBHOOK_URL=

# Shared secret checked by the Apps Script before it writes a row.
# Generate with: openssl rand -hex 16   (must match the value in the script)
SHEET_SECRET=
